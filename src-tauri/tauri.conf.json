{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DayOracle",
  "version": "0.1.0-alpha.1",
  "identifier": "io.github.ollavarma_create.dayoracle",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DayOracle",
        "width": 1050,
        "height": 800,
        "minWidth": 700,
        "minHeight": 580,
        "backgroundColor": "#101a2c"
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
